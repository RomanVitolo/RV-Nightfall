/* Shared by the lobby screen (LobbyScreen.uxml) and the in-game room panel (SessionOverlay.uxml).
   Control colours and the body font come from the theme (MultiplayerRuntimeTheme.tss); titles use Noto Serif. */

/* ---- Lobby layout ------------------------------------------------------------------------------ */

.mp-root {
    flex-grow: 1;
    padding: 48px 64px 32px 64px;
    background-color: rgb(11, 12, 15);
    color: rgb(220, 222, 226);
    font-size: 18px;
}

.mp-header {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 28px;
}

.mp-title {
    font-size: 40px;
    -unity-font-definition: url("/Assets/ThunderWire Studio/UHFPS/Content/Fonts/NotoSerif/Normal/NotoSerif-Bold.ttf");
    letter-spacing: 4px;
    color: rgb(236, 236, 238);
}

.mp-subtitle {
    font-size: 16px;
    color: rgb(128, 133, 143);
    letter-spacing: 2px;
}

.mp-card {
    flex-grow: 1;
    padding: 24px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(38, 41, 48);
    background-color: rgb(20, 22, 27);
}

.mp-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.mp-section-title {
    font-size: 26px;
    -unity-font-definition: url("/Assets/ThunderWire Studio/UHFPS/Content/Fonts/NotoSerif/Normal/NotoSerif-Bold.ttf");
    color: rgb(240, 240, 242);
}

.mp-muted {
    color: rgb(150, 155, 165);
}

.mp-spacer {
    flex-grow: 1;
}

.mp-hidden {
    display: none;
}

/* ---- Buttons and fields ------------------------------------------------------------------------ */

.mp-button {
    height: 42px;
    margin: 0 0 0 8px;
    padding: 0 22px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgb(40, 43, 50);
    color: rgb(230, 232, 236);
    font-size: 18px;
    -unity-font-definition: url("/Assets/ThunderWire Studio/UHFPS/Content/Fonts/Roboto Condensed/Normal/RobotoCondensed-Bold.ttf");
}

.mp-button:hover {
    background-color: rgb(53, 57, 66);
}

.mp-button:disabled {
    opacity: 0.4;
}

.mp-button--primary {
    background-color: rgb(146, 36, 36);
    color: rgb(255, 255, 255);
}

.mp-button--primary:hover {
    background-color: rgb(178, 46, 46);
}

.mp-button--small {
    height: 32px;
    padding: 0 16px;
    font-size: 15px;
}

.mp-field {
    margin: 8px 0;
    align-items: center;
}

.mp-field .unity-base-field__label {
    min-width: 190px;
    width: 190px;
}

.mp-field--compact {
    margin-top: 2px;
}

/* A line under a field, lined up with its input rather than its label. */
.mp-field-hint {
    margin: -2px 0 8px 193px;
    white-space: normal;
    font-size: 15px;
    color: rgb(176, 180, 190);
}

.mp-button--ghost {
    margin-left: 0;
    padding: 0 14px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(190, 194, 202);
}

.mp-button--ghost:hover {
    background-color: rgb(34, 37, 44);
}

.mp-name-field {
    width: 380px;
}

/* ---- Tables ------------------------------------------------------------------------------------ */

.mp-table-header {
    flex-direction: row;
    padding: 8px 12px;
    border-bottom-width: 1px;
    border-color: rgb(38, 41, 48);
    color: rgb(128, 133, 143);
    font-size: 14px;
}

.mp-list {
    flex-grow: 1;
}

.mp-row {
    flex-direction: row;
    align-items: center;
    height: 100%;
    padding: 0 12px;
    border-bottom-width: 1px;
    border-color: rgb(30, 33, 39);
}

.mp-col-name {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.mp-col-players {
    width: 110px;
    -unity-text-align: middle-center;
}

.mp-col-status {
    width: 140px;
    -unity-text-align: middle-center;
}

.mp-col-action {
    width: 130px;
    align-items: flex-end;
}

.mp-empty {
    padding: 48px;
    -unity-text-align: middle-center;
    color: rgb(128, 133, 143);
}

.mp-status--open {
    color: rgb(118, 198, 138);
}

.mp-status--full {
    color: rgb(220, 170, 90);
}

.mp-status--ingame {
    color: rgb(204, 92, 92);
}

.mp-badge {
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 10px;
    background-color: rgb(40, 43, 50);
    color: rgb(190, 192, 198);
    font-size: 13px;
}

.mp-badge--host {
    background-color: rgb(116, 86, 28);
    color: rgb(255, 230, 170);
}

.mp-badge--you {
    background-color: rgb(34, 68, 108);
    color: rgb(190, 220, 255);
}

/* ---- Room view --------------------------------------------------------------------------------- */

.mp-room-meta {
    flex-direction: row;
    align-items: center;
    margin: 4px 0 20px 0;
}

.mp-room-level {
    margin: 0 24px 0 8px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.mp-code {
    margin-left: 8px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
}

.mp-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 20px;
}

/* ---- Messages, dialogs, busy ------------------------------------------------------------------- */

.mp-error {
    margin-top: 8px;
    white-space: normal;
    color: rgb(230, 112, 112);
}

.mp-status-bar {
    min-height: 26px;
    margin-top: 14px;
}

.mp-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.72);
}

.mp-dialog {
    width: 640px;
    padding: 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(50, 54, 62);
    background-color: rgb(20, 22, 27);
}

.mp-busy-label {
    font-size: 22px;
    color: rgb(255, 255, 255);
}

/* ---- Character screen -------------------------------------------------------------------------- */

.mp-header-profile {
    flex-direction: row;
    align-items: center;
}

.mp-character-button {
    min-width: 220px;
}

.mp-player-role {
    margin-left: 12px;
    color: rgb(128, 133, 143);
    font-size: 15px;
}

.mp-character-screen {
    width: 90%;
    height: 86%;
    max-width: 1600px;
    padding: 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(50, 54, 62);
    background-color: rgb(20, 22, 27);
}

.mp-character-body {
    flex-grow: 1;
    flex-direction: row;
}

.mp-character-list {
    width: 260px;
    flex-shrink: 0;
    margin-right: 20px;
}

.mp-character-card {
    height: auto;
    margin: 0 0 8px 0;
    padding: 12px 16px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgb(38, 41, 48);
    background-color: rgb(26, 28, 34);
    -unity-text-align: middle-left;
    align-items: flex-start;
}

.mp-character-card:hover {
    background-color: rgb(36, 39, 46);
}

.mp-character-card--selected {
    border-color: rgb(178, 46, 46);
    background-color: rgb(44, 26, 28);
}

.mp-character-card-role {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(236, 236, 238);
}

.mp-character-card-perks {
    margin-top: 6px;
    white-space: normal;
    font-size: 14px;
    color: rgb(150, 196, 150);
}

.mp-character-card:focus {
    border-color: rgb(120, 126, 138);
}

.mp-character-card--selected:focus {
    border-color: rgb(220, 70, 70);
}

.mp-character-random {
    margin-left: 16px;
}

.mp-character-card-current {
    position: absolute;
    top: 12px;
    right: 12px;
    margin-left: 0;
}

.mp-character-card-played-by {
    margin-top: 6px;
    white-space: normal;
    font-size: 14px;
    color: rgb(214, 170, 120);
}

.mp-character-save-notice {
    margin-bottom: 16px;
    padding: 10px 14px;
    border-radius: 6px;
    border-left-width: 3px;
    border-color: rgb(214, 170, 120);
    background-color: rgb(44, 36, 26);
    color: rgb(236, 220, 196);
    white-space: normal;
}

.mp-character-preview {
    flex-grow: 1;
    min-width: 240px;
    border-radius: 6px;
    background-color: rgb(14, 15, 19);
    overflow: hidden;
}

.mp-character-preview-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.mp-character-preview-hint {
    position: absolute;
    bottom: 12px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 14px;
}

.mp-character-details {
    width: 420px;
    min-width: 300px;
    flex-shrink: 1;
    margin-left: 24px;
}

.mp-character-name .unity-base-field__label {
    min-width: 80px;
}

.mp-character-role {
    margin-top: 16px;
    font-size: 34px;
    -unity-font-definition: url("/Assets/ThunderWire Studio/UHFPS/Content/Fonts/NotoSerif/Normal/NotoSerif-Bold.ttf");
    color: rgb(255, 255, 255);
}

.mp-character-description {
    margin-top: 10px;
    white-space: normal;
    color: rgb(200, 202, 208);
}

.mp-character-heading {
    margin-top: 20px;
    margin-bottom: 6px;
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(128, 133, 143);
}

.mp-character-line {
    white-space: normal;
    margin-bottom: 2px;
}

.mp-character-variants {
    flex-direction: row;
    flex-wrap: wrap;
}

.mp-character-variant {
    width: 92px;
    margin: 0 8px 8px 0;
    padding: 4px;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(38, 41, 48);
    background-color: rgb(26, 28, 34);
    align-items: center;
}

.mp-character-variant:hover {
    background-color: rgb(36, 39, 46);
}

.mp-character-variant:focus {
    border-color: rgb(120, 126, 138);
}

.mp-character-variant--selected {
    border-color: rgb(178, 46, 46);
    background-color: rgb(44, 26, 28);
}

.mp-character-variant-picture {
    width: 80px;
    height: 80px;
    border-radius: 4px;
    background-color: rgb(14, 15, 19);
}

.mp-character-variant-name {
    margin-top: 4px;
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(220, 222, 228);
}

.mp-character-item {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.mp-character-item-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
}

/* ---- Game settings (waiting room) -------------------------------------------------------------- */

.mp-room-settings {
    margin: 12px 0;
    padding: 12px 16px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(38, 41, 48);
    background-color: rgb(24, 26, 31);
}

.mp-settings-header {
    margin-bottom: 4px;
}

.mp-settings-header .mp-character-heading {
    margin-top: 0;
    margin-bottom: 0;
}

.mp-settings-preset {
    min-width: 180px;
    margin: 0;
}

.mp-settings-summary {
    white-space: normal;
    color: rgb(214, 216, 222);
    margin-bottom: 4px;
}

.mp-settings-custom {
    margin-top: 8px;
}

.mp-setting-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.mp-setting-slider {
    flex-grow: 1;
    margin: 2px 0;
}

.mp-setting-slider .unity-base-field__label {
    min-width: 190px;
    width: 190px;
}

.mp-setting-value {
    width: 70px;
    -unity-text-align: middle-right;
    color: rgb(214, 170, 120);
}

/* ---- In-game room panel ------------------------------------------------------------------------ */

.mp-overlay-root {
    flex-grow: 1;
}

.mp-overlay-hint {
    position: absolute;
    top: 20px;
    right: 24px;
    padding: 6px 12px;
    border-radius: 6px;
    background-color: rgba(10, 10, 12, 0.6);
    color: rgb(200, 202, 208);
    font-size: 14px;
}

.mp-overlay-panel {
    position: absolute;
    top: 64px;
    right: 24px;
    width: 440px;
    padding: 20px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(50, 54, 62);
    background-color: rgba(18, 20, 24, 0.95);
    color: rgb(220, 222, 226);
    font-size: 17px;
}

.mp-player-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
}

/* The room ended without the player choosing it: said plainly, above everything else in the lobby. */
.mp-notice {
    flex-direction: row;
    align-items: center;
    border-left-width: 4px;
    border-left-color: rgb(214, 106, 84);
    background-color: rgba(214, 106, 84, 0.12);
}

.mp-notice-text {
    color: rgb(240, 202, 194);
    font-size: 15px;
    white-space: normal;
    flex-shrink: 1;
}

/* ---- Main menu --------------------------------------------------------------------------------- */

.mp-menu {
    flex-grow: 1;
    justify-content: center;
    padding-left: 60px;
}

.mp-menu-column {
    width: 560px;
}

.mp-menu-title {
    font-size: 76px;
    -unity-font-definition: url("/Assets/ThunderWire Studio/UHFPS/Content/Fonts/NotoSerif/Normal/NotoSerif-Bold.ttf");
    letter-spacing: 6px;
    white-space: normal;
    color: rgb(238, 236, 232);
}

.mp-menu-rule {
    width: 120px;
    height: 3px;
    margin: 14px 0 14px 4px;
    background-color: rgb(178, 46, 46);
}

.mp-menu-tagline {
    margin: 0 0 40px 4px;
    font-size: 20px;
    color: rgb(160, 164, 174);
}

.mp-menu-buttons {
    align-items: stretch;
}

.mp-menu-button {
    height: 60px;
    margin: 0 0 12px 0;
    padding: 0 28px;
    border-width: 0;
    border-left-width: 3px;
    border-radius: 4px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(28, 30, 36, 0.9);
    color: rgb(226, 228, 232);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("/Assets/ThunderWire Studio/UHFPS/Content/Fonts/NotoSerif/Normal/NotoSerif-Bold.ttf");
}

.mp-menu-button:hover,
.mp-menu-button:focus {
    border-color: rgb(222, 72, 72);
    background-color: rgb(44, 28, 30);
    color: rgb(255, 255, 255);
}

.mp-menu-button--primary {
    background-color: rgb(120, 30, 30);
    color: rgb(255, 255, 255);
}

.mp-menu-button--primary:hover,
.mp-menu-button--primary:focus {
    background-color: rgb(160, 40, 40);
}

.mp-menu-profile {
    margin: 24px 0 0 4px;
    font-size: 17px;
    color: rgb(160, 164, 174);
}

.mp-menu-version {
    position: absolute;
    right: 0;
    bottom: 0;
    font-size: 14px;
    color: rgb(96, 100, 110);
}

/* ---- Create Room preview ----------------------------------------------------------------------- */

.mp-dialog--wide {
    width: 1120px;
    max-width: 94%;
}

.mp-dialog-subtitle {
    margin: 2px 0 18px 0;
    color: rgb(170, 174, 184);
}

.mp-dialog-columns {
    flex-direction: row;
}

.mp-dialog-form {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mp-summary {
    width: 380px;
    flex-shrink: 0;
    margin-left: 28px;
    padding: 18px 20px;
    border-radius: 6px;
    border-width: 1px;
    border-left-width: 3px;
    border-color: rgb(46, 50, 58);
    border-left-color: rgb(178, 46, 46);
    background-color: rgb(14, 15, 19);
}

.mp-summary-heading {
    margin-top: 0;
}

.mp-summary-title {
    margin-bottom: 12px;
    font-size: 26px;
    -unity-font-definition: url("/Assets/ThunderWire Studio/UHFPS/Content/Fonts/NotoSerif/Normal/NotoSerif-Bold.ttf");
    white-space: normal;
    color: rgb(255, 255, 255);
}

.mp-summary-row {
    flex-direction: row;
    align-items: flex-start;
    margin: 4px 0;
}

.mp-summary-key {
    width: 80px;
    flex-shrink: 0;
    color: rgb(140, 145, 155);
}

.mp-summary-value {
    flex-shrink: 1;
    white-space: normal;
    -unity-font-definition: url("/Assets/ThunderWire Studio/UHFPS/Content/Fonts/Roboto Condensed/Normal/RobotoCondensed-Bold.ttf");
    color: rgb(240, 240, 242);
}

.mp-summary-note {
    margin: 2px 0 6px 80px;
    white-space: normal;
    font-size: 15px;
    color: rgb(176, 180, 190);
}

#create-summary-settings {
    margin-left: 0;
}
